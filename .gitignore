# Ignore everything by default
*

# Allow directories so negations below can match files inside
!*/

# Keep project essentials
!.gitignore
!README.md
!mkv_juicer.py
!convert_sup.py
!ffprobe_report.sh
!LICENSE

# contrib shell utilities
!contrib/
!contrib/*.sh

# Python cache and common noise
__pycache__/
*.pyc
*.pyo
*.log
.DS_Store
.venv/
.mkv_juicer-venv/
.env
